ENV=development
DEBUG=true
APP_NAME=SmartHealth Backend

# LLM provider keys
GROQ_API_KEY=

# Optional web search (used by DiseaseInfoAgent fallback)
SERPER_API_KEY=

# Local model host
OLLAMA_HOST=http://localhost:11434

# Optional path overrides
DISEASE_INFO_PATH=app/data/disease_db.csv
FAISS_SYMPTOM_PATH=app/data/vector/symptom_faiss_db/
FAISS_DISEASE_PATH=app/data/vector/disease_faiss_db/
SKIN_MODEL_PATH=app/models/skin_disease_model.pth
SKIN_MODEL_CLASS_PATH=app/models/labels.json
